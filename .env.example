# Copier vers .env (non commité) : cp .env.example .env

# --- Serveur ----------------------------------------------------------------
PORT=3000
LOG_LEVEL=info

# URL publique du site, sans slash final. Sert à construire les URL de retour
# Stripe et les liens de téléchargement envoyés par email — une valeur erronée
# produit des liens morts dans des emails déjà partis.
# En local : http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000

# Répertoire de données : base SQLite des commandes et PDF des ebooks.
# En production CapRover, c'est le point de montage du volume persistant.
# En local, ./data suffit.
DATA_DIR=./data

# --- Stripe -----------------------------------------------------------------
# Dashboard Stripe > Développeurs > Clés API. Commence par sk_test_ en test,
# sk_live_ en production.
STRIPE_SECRET_KEY=

# Secret de signature du webhook, qui authentifie les appels de Stripe.
# En local, `stripe listen` l'affiche au démarrage (whsec_...).
# En production, Dashboard > Développeurs > Webhooks > l'endpoint > Signing secret.
# Ce n'est PAS le même secret en local et en production.
STRIPE_WEBHOOK_SECRET=

# --- Brevo ------------------------------------------------------------------
# Brevo > SMTP & API > API Keys.
BREVO_API_KEY=
# Adresse validée dans Brevo > Senders & IP > Senders.
BREVO_SENDER_EMAIL=
# Optionnel, défaut « Grindrise ».
BREVO_SENDER_NAME=Grindrise
# Optionnel, aucune adresse de réponse par défaut.
BREVO_REPLY_TO=

# --- Livraison --------------------------------------------------------------
# Secret de signature HMAC des tokens de téléchargement. Générer avec :
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Le changer invalide tous les liens de téléchargement déjà envoyés.
DOWNLOAD_TOKEN_SECRET=

# Optionnels — durée de validité d'un lien et nombre de téléchargements permis.
DOWNLOAD_TOKEN_TTL_DAYS=7
DOWNLOAD_MAX_USES=5
