# Copier vers .env (non commité) : cp .env.example .env

# --- Serveur ----------------------------------------------------------------
PORT=3000
LOG_LEVEL=info

# URL publique du site, sans slash final. Sert à construire les URL de retour
# PayPlug, l'URL de notification (IPN) et les liens de téléchargement envoyés
# par email — une valeur erronée produit des liens morts dans des emails déjà
# partis, et des notifications qui n'arrivent jamais.
# PayPlug doit pouvoir joindre ${PUBLIC_BASE_URL}/api/payplug/notification :
# en local, mettre ici l'URL https d'un tunnel (voir spec/), pas localhost.
# Obligatoirement en https avec une clé live (refus au démarrage sinon).
PUBLIC_BASE_URL=http://localhost:3000

# Répertoire de données : base SQLite des commandes et PDF des ebooks.
# En production CapRover, c'est le point de montage du volume persistant.
# En local, ./data suffit.
DATA_DIR=./data

# --- PayPlug ----------------------------------------------------------------
# Clé SECRÈTE PayPlug (portail PayPlug > Développeurs / Mon compte > Clés API).
#   sk_test_… : mode test, aucun argent réel — développement et recette.
#   sk_live_… : mode live, vrais paiements — production uniquement.
# Le mode est déduit du préfixe et journalisé à chaque démarrage. Pas de valeur
# par défaut : sans clé, le serveur refuse de démarrer.
# Aucun secret de webhook : PayPlug ne signe pas ses notifications, le serveur
# relit chaque paiement auprès de l'API avec cette clé avant de livrer.
PAYPLUG_SECRET_KEY=

# --- Brevo ------------------------------------------------------------------
# Brevo > SMTP & API > API Keys.
BREVO_API_KEY=
# Adresse validée dans Brevo > Senders & IP > Senders.
BREVO_SENDER_EMAIL=
# Optionnel, défaut « Grindrise ».
BREVO_SENDER_NAME=Grindrise
# Optionnel, aucune adresse de réponse par défaut.
BREVO_REPLY_TO=

# --- Livraison --------------------------------------------------------------
# Secret de signature HMAC des tokens de téléchargement. Générer avec :
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Le changer invalide tous les liens de téléchargement déjà envoyés.
DOWNLOAD_TOKEN_SECRET=

# Optionnels — durée de validité d'un lien et nombre de téléchargements permis.
DOWNLOAD_TOKEN_TTL_DAYS=7
DOWNLOAD_MAX_USES=5
